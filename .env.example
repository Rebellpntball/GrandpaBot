# ============================================
# GrandpaBot — Environment Configuration
# ============================================

# Discord
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
GUILD_ID=your_main_discord_server_id

# MongoDB
MONGO_URI=mongodb://localhost:27017/grandpabot
# Or MongoDB Atlas:
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/grandpabot

# Bot Settings
CURRENCY_NAME=Grandpa Coins
CURRENCY_EMOJI=🪙
BOT_PREFIX=!
OWNER_IDS=123456789012345678,987654321098765432

# Optional: Post killfeed / leaderboards to X (Twitter)
X_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=

# Optional: Nitrado (for Xbox + PC log pulls)
NITRADO_TOKEN=

# Optional: FTP for PC auto-upload of base JSONs (advanced)
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_BASE_PATH=/

# Runtime
NODE_ENV=production
DEBUG=false
